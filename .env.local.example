# Copy this file to .env.local and fill in your values

# Neon database connection string
# Get this from: https://console.neon.tech -> your project -> Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google AdSense publisher ID (format: ca-pub-XXXXXXXXXXXXXXXXXX)
# Get this from: https://www.google.com/adsense -> Account -> Account information
# Leave unset to disable AdSense entirely, all ad slots render nothing (no
# placeholders, no reserved space) when this is absent.
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXXXX

# Your production domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://insurancetools.org

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX)
# Get this from: https://analytics.google.com -> Admin -> Data Streams -> your stream
# Optional. There is no built-in default: leaving this unset disables GA
# entirely (no request, no reserved space).
NEXT_PUBLIC_GA_ID=
