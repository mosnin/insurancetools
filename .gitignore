# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code runtime state (skills under .claude/skills are tracked)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Agent scratch files
_scratch_*
scratchpad_dump.ts

# Transient audit helper scripts written by content agents during a
# density pass. They hardcode a batch file list and are not part of the
# tooling, so they stay out of version control.
scripts/check16.mjs
scripts/dump-tmp.mjs
